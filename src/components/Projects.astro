---
import { Image } from 'astro:assets';
import render from '../assets/img/necochea-render.jpg';
import real from '../assets/img/necochea-obra.jpg';
import casa from '../assets/img/p-casa-ladrillo.jpg';
import living from '../assets/img/p-living.jpg';
import pileta from '../assets/img/p-pileta.jpg';
import bano from '../assets/img/p-bano.jpg';
import estar from '../assets/img/p-estar.jpg';
import obraNueva from '../assets/img/obra-nueva.jpg';

const projects = [
  { img: casa, title: 'Casa Funes', tag: 'Obra nueva', year: '2024', alt: 'Vivienda de dos plantas con volumen de ladrillo y jardín' },
  { img: living, title: 'Departamento Pichincha', tag: 'Interiorismo', year: '2024', alt: 'Living luminoso con sillón de cuero y plantas' },
  { img: pileta, title: 'Casa Roldán', tag: 'Obra nueva', year: '2023', alt: 'Interior con escalera de madera y vista a la pileta' },
  { img: bano, title: 'Baño Fisherton', tag: 'Reforma', year: '2023', alt: 'Baño reformado en tonos grises con bañera exenta' },
  { img: estar, title: 'PH Echesortu', tag: 'Reforma', year: '2023', alt: 'Estar con sillón mostaza y piso de madera' },
  { img: obraNueva, title: 'Casa Kentucky', tag: 'Obra nueva', year: '2022', alt: 'Vivienda con fachada de madera y patio de acceso' },
];
---

<section id="proyectos" class="section bg-paper">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow reveal">Proyectos</p>
        <h2 class="h2-editorial mt-5 reveal" style="--d:100ms">Obras que ya son casa</h2>
      </div>
      <p class="text-ink/75 md:col-span-4 md:col-start-9 reveal" style="--d:180ms">
        Una selección de trabajos en Rosario y alrededores: viviendas nuevas, reformas e interiores.
      </p>
    </div>

    <!-- Caso destacado: render vs. obra real -->
    <article class="mt-16 grid gap-10 border-t border-line pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4 reveal">
        <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-brown">Caso destacado</p>
        <h3 class="display mt-4 text-[40px] lg:text-[48px]">Obra Necochea</h3>
        <p class="lede mt-3 text-ink/80">Render vs. obra real</p>
        <p class="mt-6 text-ink/75">
          Lo que te muestro en el proyecto es lo que vas a vivir. Deslizá para comparar la imagen del anteproyecto con la
          obra terminada.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-y-5 border-t border-line pt-6 text-[15px]">
          <dt class="eyebrow">Tipo</dt><dd>Reforma integral</dd>
          <dt class="eyebrow">Superficie</dt><dd>140 m²</dd>
          <dt class="eyebrow">Plazo</dt><dd>7 meses</dd>
          <dt class="eyebrow">Ubicación</dt><dd>Rosario</dd>
        </dl>
      </div>

      <div class="lg:col-span-8 reveal" style="--d:120ms">
        <div class="compare relative aspect-[4/3] select-none overflow-hidden bg-cream" style="--pos:50%">
          <Image src={real} alt="Obra terminada: living integrado con revestimiento de madera" class="absolute inset-0 h-full w-full object-cover" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 66vw, 100vw" />
          <div class="compare-top absolute inset-0">
            <Image src={render} alt="Render del anteproyecto del mismo living" class="h-full w-full object-cover" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 66vw, 100vw" />
          </div>
          <span class="pointer-events-none absolute left-4 top-4 bg-paper/85 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.22em]">Render</span>
          <span class="pointer-events-none absolute right-4 top-4 bg-night/80 px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.22em] text-on-dark">Obra real</span>
          <div class="compare-handle pointer-events-none absolute inset-y-0 w-px bg-on-dark">
            <span class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-on-dark bg-night/60 text-on-dark backdrop-blur">
              <svg width="20" height="12" viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="1"><path d="M6 1 1 6l5 5M14 1l5 5-5 5" /></svg>
            </span>
          </div>
          <input type="range" min="0" max="100" value="50" aria-label="Comparar render y obra real" class="compare-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
        </div>
      </div>
    </article>

    <div class="mt-24 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8">
      {projects.map((p, i) => (
        <article class="group reveal" style={`--d:${(i % 3) * 120}ms`}>
          <div class="zoom aspect-[4/5] overflow-hidden bg-cream">
            <Image src={p.img} alt={p.alt} class="h-full w-full object-cover" widths={[480, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
          </div>
          <div class="mt-5 flex items-baseline justify-between gap-4 border-b border-line pb-4">
            <h3 class="font-display text-[26px] leading-tight">{p.title}</h3>
            <span class="font-mono text-[11px] tracking-[0.2em] text-taupe">{p.year}</span>
          </div>
          <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.25em] text-brown">{p.tag}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .compare-top {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .compare-handle {
    left: var(--pos);
  }
  .compare:has(.compare-range:focus-visible) {
    outline: 1px solid var(--color-brown);
    outline-offset: 4px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.compare').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.compare-range')!;
    const set = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
