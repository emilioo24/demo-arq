---
import { Image } from 'astro:assets';
import obraNueva from '../assets/img/obra-nueva.jpg';
import reformas from '../assets/img/reformas.jpg';
import interiorismo from '../assets/img/interiorismo.jpg';

const services = [
  {
    n: '01',
    title: 'Obra nueva',
    text: 'Viviendas unifamiliares pensadas desde el terreno: orientación, programa y presupuesto, hasta la última terminación.',
    img: obraNueva,
    alt: 'Fachada de vivienda contemporánea con madera y hormigón',
  },
  {
    n: '02',
    title: 'Reformas',
    text: 'Ampliaciones, remodelaciones y puesta en valor. Cambiar lo que tenés sin que la obra se vuelva una pesadilla.',
    img: reformas,
    alt: 'Interior reformado con piso de madera y paredes claras',
  },
  {
    n: '03',
    title: 'Interiorismo',
    text: 'Materiales, iluminación, mobiliario y equipamiento a medida para que cada espacio se sienta propio.',
    img: interiorismo,
    alt: 'Living cálido con sillón gris, cuero y luz natural',
  },
];
---

<section id="servicios" class="section bg-paper">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow reveal">Servicios</p>
        <h2 class="h2-editorial mt-5 reveal" style="--d:100ms">Cómo te puedo acompañar</h2>
      </div>
      <p class="text-ink/75 md:col-span-4 md:col-start-9 reveal" style="--d:180ms">
        Cada proyecto es distinto, pero el compromiso es el mismo: una obra bien documentada, bien presupuestada y bien
        ejecutada.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3 lg:gap-8">
      {services.map((s, i) => (
        <article class="zoom group relative aspect-[4/5] overflow-hidden bg-night reveal" style={`--d:${i * 120}ms`}>
          <Image
            src={s.img}
            alt={s.alt}
            class="absolute inset-0 h-full w-full object-cover"
            widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 33vw, 100vw"
          />
          <div class="absolute inset-x-0 bottom-0 bg-overlay p-7 text-on-dark transition-[padding] duration-700 ease-soft lg:group-hover:pb-10">
            <p class="font-mono text-[11px] tracking-[0.25em] text-sand">{s.n}</p>
            <h3 class="display mt-3 text-[34px] lg:text-[38px]">{s.title}</h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-on-dark/80">{s.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
