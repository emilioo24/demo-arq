---
const withoutMe = [
  'Varios profesionales que no se hablan entre sí',
  'Presupuestos que cambian a mitad de obra',
  'Vos coordinando gremios, compras y plazos',
];
const withMe = [
  { t: 'Una sola interlocutora', d: 'Yo coordino arquitectura, gremios, proveedores y trámites. Vos hablás con una persona.' },
  { t: 'Legajo técnico completo', d: 'Planos, planillas y especificaciones que dejan poco lugar a la improvisación.' },
  { t: 'Presupuesto por etapas', d: 'Sabés cuánto cuesta cada parte de la obra antes de empezarla.' },
  { t: 'Seguimiento semanal', d: 'Reportes con fotos y avances para que sigas tu obra aunque no puedas ir.' },
];
---

<section id="llave-en-mano" class="section relative overflow-hidden bg-night text-on-dark">
  <div class="wrap grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow !text-sand reveal">Servicio integral</p>
      <h2 class="display mt-6 text-[48px] sm:text-[64px] lg:text-[76px] reveal" style="--d:100ms">Llave<br />en mano</h2>
      <p class="lede mt-6 text-on-dark/80 reveal" style="--d:180ms">
        De la idea a las llaves, con una sola interlocutora.
      </p>

      <div class="mt-14 flex items-end gap-6 reveal" style="--d:260ms">
        <span class="lnum font-display text-[160px] font-light leading-[0.75] text-sand lg:text-[200px]">1</span>
        <p class="max-w-[16ch] pb-2 font-mono text-[11.5px] uppercase leading-relaxed tracking-[0.22em] text-on-dark/70">
          responsable de todo tu proyecto
        </p>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <div class="reveal">
        <p class="eyebrow !text-on-dark/50">Lo que suele pasar</p>
        <ol class="mt-5">
          {withoutMe.map((item, i) => (
            <li class="flex gap-6 border-t border-white/10 py-4 text-on-dark/55 line-through decoration-white/25">
              <span class="font-mono text-[11px] tracking-[0.2em] no-underline">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-14 reveal" style="--d:120ms">
        <p class="eyebrow !text-sand">Cómo lo resuelvo</p>
        <ol class="mt-5">
          {withMe.map((item, i) => (
            <li class="grid grid-cols-[3rem_1fr] border-t border-white/15 py-6 last:border-b">
              <span class="pt-1 font-mono text-[11px] tracking-[0.2em] text-sand">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-[19px] font-medium uppercase tracking-[0.06em]">{item.t}</h3>
                <p class="mt-2 text-on-dark/70">{item.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
